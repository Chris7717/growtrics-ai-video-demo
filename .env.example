# Database Configuration
# Local SQLite database for development
DATABASE_URL=sqlite+aiosqlite:///./growtrics.db

# PostgreSQL example (if switching back to Postgres in the future)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/growtrics_ai_video

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=info

# AI & Third-Party APIs (Phase 3 & Phase 4)
# GEMINI_API_KEY=your_gemini_api_key_here
# MINIO_ACCESS_KEY=your_minio_access_key
# MINIO_SECRET_KEY=your_minio_secret_key
